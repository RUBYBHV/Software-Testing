#!/bin/sh
# pre-commit - Code Quality Check
echo "Running pre-commit hook... Checking code quality."

# Example: Check for trailing whitespaces before allowing commit
if git rev-parse --verify HEAD >/dev/null 2>&1
then
	against=HEAD
else
	# Initial commit: diff against an empty tree object
	against=4b825dc642cb6eb9a060e54bf8d69288fbee4904
fi

# Redirect output to stderr.
exec 1>&2

if git diff --cached --check "$against" --; then
    echo "[OK] Code quality checks passed."
    exit 0
else
    echo "[ERROR] Code quality check failed: Trailing whitespaces or syntax issues found."
    echo "Please fix the issues and try committing again."
    exit 1
fi
